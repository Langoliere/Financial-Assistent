# Пример переменных окружения
# Скопируйте файл в .env и задайте значения для своего окружения
# Не добавляйте .env в систему контроля версий

# Настройки Python
PYTHONUNBUFFERED=1

# Настройки API
# API_HOST=0.0.0.0
# API_PORT=8000
# CORS_ALLOWED_ORIGINS=http://localhost:8000
# TRUSTED_HOSTS=localhost,127.0.0.1
# INVESTBOT_API_KEY=
# MAX_REQUEST_BODY_BYTES=262144
# PREDICTION_RATE_LIMIT_PER_MINUTE=30

# Настройки модели
# ARTIFACTS_DIR=./artifacts/direction_model
# LOOKBACK_WINDOW=20

# Настройки MLflow
# MLFLOW_TRACKING_URI=file:///E:/Pet_Projects/Devin/Financial Assistent/mlruns
# MLFLOW_EXPERIMENT_NAME=sber_direction_prediction
# MLFLOW_MODEL_NAME=sber_direction_lstm
# MLFLOW_MODEL_ALIAS=champion
# MLFLOW_CANDIDATE_ALIAS=candidate
# MLFLOW_RUN_ID=  # Необязательно: конкретный run ID

# Контроль качества и дрейфа данных
# MAX_MARKET_DATA_AGE_DAYS=7
# MAX_DATA_DRIFT_SCORE=5.0
# BLOCK_ON_DATA_DRIFT=false

# Логирование
# LOG_LEVEL=INFO
